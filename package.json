{
  "name": "seedance3-blog-cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:d1": "tsx --test tests/d1-*.test.ts tests/neon-to-d1-migration.test.mjs",
    "db:d1:local": "wrangler d1 migrations apply seedance3-production --local",
    "test": "node --test tests/*.test.mjs",
    "test:auth": "tsx --test tests/*.test.ts",
    "predev": "npm run db:d1:local",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/sync-site-navigation.mjs && node scripts/build-home-video.mjs && vite build && tsc --noEmit",
    "sync:navigation": "node scripts/sync-site-navigation.mjs",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types src/worker-bindings.d.ts --env-interface WorkerBindings",
    "start:cms": "node server.local.js",
    "dev:worker": "wrangler dev",
    "sync:worker-secrets": "wrangler secret bulk .env.local",
    "deploy:worker": "npm run build && wrangler deploy --secrets-file .env.local"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@neondatabase/serverless": "^1.0.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "better-auth": "1.7.5",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "http-parser-js": "0.5.10",
    "mammoth": "^1.12.3",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@electric-sql/pglite": "^0.5.10",
    "@tanstack/router-cli": "^1.167.38",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "jszip": "^3.10.2",
    "meshoptimizer": "^1.2.0",
    "miniflare": "5.20260917.0-alpha",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  }
}
