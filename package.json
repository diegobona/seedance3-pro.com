{
  "name": "seedance3-blog-cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:auth": "tsx --test tests/*.test.ts",
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types",
    "start:cms": "node server.local.js",
    "dev:worker": "wrangler dev",
    "sync:worker-secrets": "wrangler secret bulk .env.local",
    "deploy:worker": "npm run sync:worker-secrets && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@neondatabase/serverless": "^1.0.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "better-auth": "1.7.5",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "mammoth": "^1.12.3",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@tanstack/router-cli": "^1.167.38",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "jszip": "^3.10.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  }
}
