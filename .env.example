# One file is used by local TanStack development, Drizzle, and Worker secret sync.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
TUZI_API_KEY=replace_with_your_key
AUTODL_TOKEN=replace_with_your_token

# Optional provider override. Leave unset to use https://api.tu-zi.com.
# TUZI_API_BASE=https://api.tu-zi.com

# Existing Blog CMS secrets, only when deploying that feature in the same Worker.
# ADMIN_TOKEN=
# GH_OWNER=
# GH_REPO=
# GH_TOKEN=
# GH_BRANCH=main
# SITE_BASE_URL=https://seedance3-pro.com
