{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seedance3-blog-cms-worker",
  "main": "./src/server.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "seedance3-pro.com/*",
      "zone_name": "seedance3-pro.com"
    },
    {
      "pattern": "www.seedance3-pro.com/*",
      "zone_name": "seedance3-pro.com"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "VIDEO_UPLOAD_RATE_LIMITER",
      "namespace_id": "31002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "31001",
      "simple": {
        "limit": 2,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "VIDEO_REFERENCES",
      "bucket_name": "seedance3-video-references"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CMS_JOBS",
      "id": "fa1e1517a43444f899d34abb737486b2"
    }
  ]
}
