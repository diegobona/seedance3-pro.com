{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seedance3-blog-cms-worker",
  "main": "./src/server.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "seedance3-pro.com/api/*", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/api/*", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/app*", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/app*", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/app-assets/*", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/app-assets/*", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/minimax-h3-ai-video-generator", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/minimax-h3-ai-video-generator", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/gpt-image-2", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/gpt-image-2", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/minimax-h3-ai-video-generator.html", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/minimax-h3-ai-video-generator.html", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/gpt-image-2.html", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/gpt-image-2.html", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/prompt-guide", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/prompt-guide", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/minimax-h3-prompts", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/minimax-h3-prompts", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/minimax-h3-prompts/*", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/minimax-h3-prompts/*", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/gpt-image-2-prompts", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/gpt-image-2-prompts", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/gpt-image-2-prompts/*", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/gpt-image-2-prompts/*", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/seedance-3-0-prompts", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/seedance-3-0-prompts", "zone_name": "seedance3-pro.com" },
    { "pattern": "seedance3-pro.com/prompts/*", "zone_name": "seedance3-pro.com" },
    { "pattern": "www.seedance3-pro.com/prompts/*", "zone_name": "seedance3-pro.com" }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app", "/app/", "/app/video/*", "/app/image/*", "/minimax-h3-ai-video-generator", "/gpt-image-2", "/minimax-h3-ai-video-generator.html", "/gpt-image-2.html", "/prompt-guide", "/minimax-h3-prompts", "/minimax-h3-prompts/*", "/gpt-image-2-prompts", "/gpt-image-2-prompts/*", "/seedance-3-0-prompts", "/prompts/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "ratelimits": [
    {
      "name": "VIDEO_UPLOAD_RATE_LIMITER",
      "namespace_id": "31002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "31001",
      "simple": { "limit": 2, "period": 60 }
    }
  ],
  "r2_buckets": [
    { "binding": "VIDEO_REFERENCES", "bucket_name": "seedance3-video-references" }
  ],
  "kv_namespaces": [
    { "binding": "CMS_JOBS", "id": "fa1e1517a43444f899d34abb737486b2" }
  ]
}
